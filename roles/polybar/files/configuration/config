[global/wm]
include-file = ~/.config/polybar/colors.ini
include-directory = ~/.config/polybar/modules

[bar/top]
width = 100%
height = 32
module-margin = 1

background = ${colors.background}
foreground = ${colors.white}

font-0 = Maple Mono NF:size=15;5
font-1 = Maple Mono NF:size=16;5
font-2 = Maple Mono NF:size=22;7
font-3 = Maple Mono NF:size=24;7

modules-left = workspaces window
modules-right = services cpu bluetooth network volume battery date notifications

enable-ipc = true


; vim: filetype=dosini
